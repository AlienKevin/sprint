# One global default for both the rendered agent instruction and enforced cap.
# An explicit environment value may override it for a whole launch or batch.
AGENT_COST_BUDGET_USD=${AGENT_COST_BUDGET_USD:-10}

# The cloud-side watchdog starts shutdown this far below the cap to cover
# graceful CPU/GPU teardown. A request already in flight may finish above the
# cap; the local API proxy prevents a second paid request after that crossing.
# This is part of the same budget, not an additional allowance.
AGENT_COST_SHUTDOWN_RESERVE_USD=${AGENT_COST_SHUTDOWN_RESERVE_USD:-auto}
