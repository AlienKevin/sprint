# One global default for both the rendered agent instruction and enforced cap.
# An explicit environment value may override it for a whole launch or batch.
AGENT_COST_BUDGET_USD=${AGENT_COST_BUDGET_USD:-10}

# Begin graceful shutdown only after the full budget is spent. A request already
# in flight, plus CPU/GPU teardown, may finish above the cap; the local API proxy
# prevents a second paid request after that crossing.
AGENT_COST_SHUTDOWN_RESERVE_USD=${AGENT_COST_SHUTDOWN_RESERVE_USD:-0}
