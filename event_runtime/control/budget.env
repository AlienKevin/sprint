# One global default for both the rendered agent instruction and enforced cap.
# An explicit environment value may override it for a whole launch or batch.
AGENT_COST_BUDGET_USD=${AGENT_COST_BUDGET_USD:-10}

# The cloud-side watchdog starts shutdown this far below the cap, leaving room
# for the in-flight provider response and graceful CPU/GPU teardown. This is
# part of the same budget, not an additional allowance.
AGENT_COST_SHUTDOWN_RESERVE_USD=${AGENT_COST_SHUTDOWN_RESERVE_USD:-0.60}
