{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "synopsis": {
      "type": "string",
      "minLength": 40,
      "maxLength": 700
    },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 80
          },
          "start_step_id": {
            "type": "string",
            "minLength": 1
          },
          "end_step_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 30,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "start_step_id",
          "end_step_id",
          "title",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["synopsis", "chapters"],
  "additionalProperties": false
}
