# Load with: set -a; source .env; set +a
# Parent OpenRouter key used only for preflight model, route, credit, and live probes.
OPENROUTER_API_KEY=
# Management key used to create and revoke one model/provider/budget-locked key per trial.
OPENROUTER_MANAGEMENT_KEY=
# Optional when the active Modal CLI profile is already the intended account.
MODAL_PROFILE=
